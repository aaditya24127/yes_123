# Copy to .env (never commit .env). Local development defaults shown. Paths are relative to wherever the project folder is.
TARGET=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crp
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=   (leave unset to use the project folder)

# --- Website addresses allowed to call the API (add the real domain when the site goes live) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Background workers inside the API (imports, transcription, evaluation). For more capacity also run:  python -m app.jobs
WORKERS_IN_API=1

# --- AI. Who does each job is set in config/ai.json. Every key is optional: without keys the free built-in rules are used. ---
# ANTHROPIC_API_KEY=          Claude (sorting unclear files, reading reports and scans, questions, lesson evaluation)
# GEMINI_API_KEY=             Gemini free tier for scans; also set READ_PROVIDER=gemini. Demo data only (free tiers may train on inputs).
# READ_PROVIDER=gemini
# GROQ_API_KEY=               Groq Whisper speech-to-text (free tier); otherwise Whisper runs on this computer
# Override the order for one job without editing config/ai.json, e.g.:
# AI_TASK_EXTRACT_RECORDS=my_model,rules
# AI_PROVIDER_CLAUDE_SMART_MODEL=claude-sonnet-5-5
# AI_PROVIDER_MY_MODEL_ENABLED=true

# --- Supabase (fill these in later; see docs/SUPABASE.md) ---
# TARGET=supabase
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key - server side only>
# SUPABASE_BUCKET=crp-files
