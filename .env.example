# Copy to .env (never commit .env). Local development defaults shown. Paths are relative to wherever the project folder is.
TARGET=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crp
STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=   (leave unset to use the project folder)

# ======================= SUPABASE (online database + file storage, Mumbai) =======================
# Steps: docs/SUPABASE.md. Fill these 3, run  python database/cli.py setup  with TARGET=supabase, and the whole app uses Supabase.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=crp-files

# ======================= AI KEYS (all optional; who does each job: config/ai.json) =======================
# Empty = that AI is skipped and the next one / the free built-in rules are used. Changes apply without a restart.
# Check them on Settings > "Test AI connections" (free). Step-by-step: docs/SETUP_KEYS.md
ANTHROPIC_API_KEY=
# Cap in US dollars for paid AI (Claude); when the app's logged cost reaches it, Claude is skipped.
AI_BUDGET_USD=50
# Gemini free tier, second choice after Claude for every job. READ_PROVIDER=gemini switches it on. DEMO DATA ONLY.
GEMINI_API_KEY=
READ_PROVIDER=
# Groq free speech-to-text; without it Whisper runs on the server for free.
GROQ_API_KEY=
# Override the order for one job without editing config/ai.json, e.g.:
# AI_TASK_EXTRACT_RECORDS=my_model,rules
# AI_PROVIDER_CLAUDE_SMART_MODEL=claude-sonnet-5-5

# ======================= Other =======================
# Websites / apps allowed to call the API (add the real domain when the site goes live)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,https://localhost
# Background workers inside the API (imports, transcription, evaluation). More capacity: run  python -m app.jobs  as well.
WORKERS_IN_API=1

# Teacher app logins
TEACHER_AUTH_SECRET=change-me-to-a-long-random-text
DEMO_TEACHER_PASSWORD=pass123
