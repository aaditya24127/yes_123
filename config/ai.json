{
  "_readme": [
    "Who does each AI job. Change this file (or the AI_* environment variables) to switch AI; no code changes needed.",
    "providers: named AI back-ends. A provider is skipped automatically when its key is missing or enabled is false.",
    "tasks: for each job, the providers to try in order. The first one that is available and answers correctly wins.",
    "'rules' is the free built-in fallback (no AI). Keep it last so the app always works.",
    "To plug in your own trained model: run it behind a web address that accepts {task, input} and returns the task's output JSON,",
    "add a provider of type 'http' with that url, and put its name first in the tasks it should handle.",
    "Override from the environment: AI_TASK_EXTRACT_RECORDS=my_model,rules   AI_PROVIDER_CLAUDE_SMART_MODEL=claude-sonnet-5-5"
  ],
  "providers": {
    "rules":         { "type": "rules" },
    "claude_fast":   { "type": "claude", "model": "claude-haiku-5-5", "needs_env": "ANTHROPIC_API_KEY", "price_per_mtok": [0.10, 0.50] },
    "claude_smart":  { "type": "claude", "model": "claude-opus-5-5", "effort": "high", "needs_env": "ANTHROPIC_API_KEY", "price_per_mtok": [4.0, 20.0],
                       "refusal_fallback": true },
    "claude_search": { "type": "claude", "model": "claude-haiku-5-5", "needs_env": "ANTHROPIC_API_KEY", "price_per_mtok": [0.10, 0.50], "web_search": true,
                       "allowed_domains": ["ncert.nic.in", "ebalbharati.in", "books.ebalbharati.in", "diksha.gov.in", "epathshala.nic.in", "cbseacademic.nic.in",
                                           "maa.ac.in", "scert.kerala.gov.in", "tnschools.gov.in", "textbooks.karnataka.gov.in", "gseb.org", "scertodisha.nic.in"] },
    "gemini_free":   { "type": "gemini", "model": "gemini-2.5-flash", "needs_env": "GEMINI_API_KEY", "enabled_env": "READ_PROVIDER=gemini",
                       "note": "Free tier may use inputs for training: demo data only." },
    "ollama_local":  { "type": "ollama", "model": "qwen2.5vl:7b", "url": "http://localhost:11434", "enabled": false,
                       "note": "Runs on this computer for free. Install a model with: ollama pull qwen2.5vl:7b, then set enabled to true." },
    "my_model":      { "type": "http", "url": "http://localhost:9000/predict", "enabled": false, "timeout": 120,
                       "note": "Your own trained model. Receives POST {task, input} and must return the task's output JSON." },
    "groq_whisper":  { "type": "groq_whisper", "model": "whisper-large-v3", "needs_env": "GROQ_API_KEY" },
    "whisper_local": { "type": "local_whisper", "model": "base", "note": "Free speech-to-text on this computer (faster-whisper)." },
    "web_free":      { "type": "web_search_free", "allowed_domains": ["ncert.nic.in", "ebalbharati.in", "books.ebalbharati.in", "diksha.gov.in",
                                                                      "epathshala.nic.in", "cbseacademic.nic.in", "maa.ac.in"] }
  },
  "tasks": {
    "classify_document":     ["claude_fast", "ollama_local", "rules"],
    "extract_records":       ["claude_fast", "ollama_local", "my_model", "rules"],
    "extract_records_scan":  ["claude_smart", "gemini_free", "ollama_local", "rules"],
    "transcribe":            ["groq_whisper", "whisper_local", "rules"],
    "suggest_factor":        ["claude_fast", "ollama_local", "rules"],
    "visit_brief":           ["claude_fast", "ollama_local", "rules"],
    "student_questions":     ["claude_smart", "ollama_local", "rules"],
    "evaluate_lesson":       ["claude_smart", "ollama_local", "my_model", "rules"],
    "find_textbooks":        ["claude_search", "web_free", "rules"],
    "ask_copilot":           ["claude_fast", "ollama_local", "rules"]
  }
}
