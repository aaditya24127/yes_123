# CRP Mentor Copilot — Environment Configuration Template
# Copy this file to .env and customize for your local or production backend:

# Base URL for the backend API server
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional analytics or telemetry endpoint
# VITE_ANALYTICS_ENDPOINT=

# Environment mode: 'development' | 'production'
# NODE_ENV=development

# Address of the CRP Mentor Copilot app that the "Open the app" buttons go to
VITE_APP_URL=http://localhost:3000
